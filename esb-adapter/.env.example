# Adapter 监听端口（不可通过管理端热更新；改端口需重启）
PORT=13001

# 管理端访问密钥（浏览器打开 /admin/；请求头 X-Esb-Admin-Secret）
# 留空或 change-me 时不强制鉴权；生产请改为强密钥
ESB_ADMIN_SECRET=

# 运行时配置覆盖文件（热更新持久化；Docker 默认 /app/data/runtime-config.json）
# ESB_RUNTIME_CONFIG_PATH=./data/runtime-config.json

# 日志颜色（docker logs 里按 INFO/WARN/ERROR 着色；设为 false 可关闭）
LOG_COLOR=true

# 中间 POLL 详细日志（POLL_IN / ROUTE_RESOLVED / POLL_STATE；默认 false）
# 最终轮 POLL_FINAL_*、错误轮、START 请求日志不受此开关影响
LOG_POLL_STATE=false

# 宿主机 IP（Docker 内自动探测会得到容器 IP，部署时建议由 start.sh 注入或在此填写）
# HOST_IP=10.0.0.1

# Because 地址（均可留空使用默认）
# 默认：http://本机IP
# zb：同默认地址
# result：http://本机IP:18080
BECAUSE_BASE_URL=
BECAUSE_BASE_URL_ZB=
BECAUSE_BASE_URL_RESULT=

# ESB专用服务账号
BECAUSE_EMAIL=test@qq.com
BECAUSE_PASSWORD=Aa123123.

# Agent ID（在 Because 管理界面获取  --scene "zb" \ 和   --scene "result" \）

AGENT_ID_RESULT=agent_TtGGaKoWRddnv-cOLuGwd
AGENT_ID_ZB=agent_-8ikS7Vs3RPoNxVVvS9Mk

# ESB 我方应用编号（日志标识，可选）
ESB_SERVER_CD=033

# Because 聊天空闲超时（毫秒）：连续这么久无 SSE 数据才中断；有输出时会重置计时
# 归因场景建议 300000（5 分钟无新数据才超时，而非总时长上限）
CHAT_TIMEOUT_MS=300000

# Because 登录 / refresh token 接口超时（毫秒）：避免登录接口卡住时任务一直停在取 token 阶段
AUTH_TIMEOUT_MS=30000


# Stream任务过期时间
STREAM_TASK_TTL_MS=300000

# JWT 提前刷新偏移（毫秒）
TOKEN_REFRESH_SKEW_MS=60000

# queryContext 拼接到 text 后的归因提示词
QUERY_CONTEXT_ATTRIBUTION_SUFFIX=如果是管理行/总行，按其下一级机构维度分解归因，返回前五贡献/拖累项；如果是无下属的网点，则对指标进行拆解归因。根据以上逻辑，开始归因。

TEXT_LAST_BLOCK_ONLY_RESULT=true
TEXT_LAST_BLOCK_ONLY_ZB=true
